# ---------------------------------------------------------------------------
# EnrikDraw environment variables
#
# Copy this file to .env.local for local development, and set the same names in
# the Vercel project settings for the deployment.
# ---------------------------------------------------------------------------

# The public address of this app, with no trailing slash.
# Used to build the editor and Notion embed URLs shown on /manage.
# Leave it empty locally and the app works out the address from the request.
# Example on Vercel: https://enrikdraw.vercel.app
NEXT_PUBLIC_APP_URL=

# Supabase project URL. Supabase dashboard > Project Settings > Data API.
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service role key. SECRET. Server side only, never sent to a browser.
# Supabase dashboard > Project Settings > API Keys > service_role.
SUPABASE_SERVICE_ROLE_KEY=

# The single username and password for the /manage page, over HTTP Basic Auth.
OWNER_USERNAME=enrik
OWNER_PASSWORD=change-this-to-a-long-password

# SECRET. The key used to derive each drawing's access token.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it invalidates every drawing URL you have already pasted into Notion.
DRAWING_ACCESS_SECRET=

# Optional. Space separated list of sites allowed to put this app in an iframe.
# Leave it unset unless a Notion embed shows a blank box; see the README.
# FRAME_ANCESTORS='self' https://*.notion.so https://*.notion.site https://*.notion.com
